# Copy this file to .env and fill in your own values. Never commit .env.
# Only scripts/draft_demo_reply.py reads it. Real environment variables win.

# Name shown in the From header of the draft.
DEMO_SENDER_NAME=Your Name

# One block per mailbox alias. The alias is what you pass to --mailbox, here "main".
MAIN_EMAIL=you@example.com
# For Gmail use an app password, not the account password.
MAIN_PASSWORD=your-imap-password
# Optional for @gmail.com addresses (imap.gmail.com is assumed), required otherwise.
MAIN_IMAP_HOST=imap.example.com
# Optional. Use \n for line breaks. Falls back to DEMO_SENDER_NAME.
MAIN_SIGNATURE=Your Name\nYour Studio

# Optional. Folder of a CRM that exposes scripts/crm.py (see README, "CRM hook").
# DEMO_CRM_DIR=/path/to/crm
